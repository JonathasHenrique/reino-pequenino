; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by hand.

config_version=5

[application]

config/name="Reino Pequenino"
config/description="Jogo de defesa e aventura isométrica em diorama 3D"
run/main_scene="res://scenes/stages/StageCoreTest.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/autoloads/Settings.gd"
SaveManager="*res://scripts/autoloads/SaveManager.gd"
GameState="*res://scripts/autoloads/GameState.gd"
AudioManager="*res://scripts/autoloads/AudioManager.gd"
MiniGameRunner="*res://scripts/autoloads/MiniGameRunner.gd"
StoreService="*res://scripts/autoloads/StoreService.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[rendering]

textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
