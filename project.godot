; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tiny Crown: Kingdom Defense"
config/description="Jogo de defesa e aventura isométrica em diorama 3D"
run/main_scene="res://scenes/ui/MainMenu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/autoloads/Settings.gd"
I18n="*res://scripts/autoloads/I18n.gd"
SceneTransition="*res://scripts/autoloads/SceneTransition.gd"
SaveManager="*res://scripts/autoloads/SaveManager.gd"
GameState="*res://scripts/autoloads/GameState.gd"
AudioManager="*res://scripts/autoloads/AudioManager.gd"
MiniGameRunner="*res://scripts/autoloads/MiniGameRunner.gd"
StoreService="*res://scripts/autoloads/StoreService.gd"
AdManager="*res://scripts/autoload/AdManager.gd"
RetroFilterOverlay="*res://scenes/ui/RetroFilterOverlay.tscn"
Art="*res://scripts/core/Art.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[physics]

common/physics_interpolation=true

[gui]

theme/custom="res://assets/ui/KingdomTheme.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

textures/vram_compression/import_etc2_astc=true
scaling_3d/mode=0
scaling_3d/scale=0.75
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_debanding=false
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/directional_shadow/size.mobile=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=0
