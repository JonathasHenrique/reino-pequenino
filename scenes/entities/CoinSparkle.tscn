[gd_scene load_steps=5 format=3]

[sub_resource type="GDScript" id="GDScript_sparkle"]
script/source = "extends Node3D

var timer: float = 0.45

func _process(delta: float) -> void:
	timer -= delta
	position.y += delta * 1.8
	scale = scale.lerp(Vector3.ZERO, delta * 4.0)
	if timer <= 0.0:
		queue_free()
"

[sub_resource type="BoxMesh" id="BoxMesh_star"]
size = Vector3(0.18, 0.18, 0.18)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_gold"]
albedo_color = Color(1, 0.9, 0.2, 1)
emission_enabled = true
emission = Color(1, 0.85, 0.25, 1)
emission_energy_multiplier = 2.0

[node name="CoinSparkle" type="Node3D"]
script = SubResource("GDScript_sparkle")

[node name="MeshInstance3D" type="MeshInstance3D" parent="."]
mesh = SubResource("BoxMesh_star")
surface_material_override/0 = SubResource("StandardMaterial3D_gold")

