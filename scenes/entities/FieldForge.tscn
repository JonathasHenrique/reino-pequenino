[gd_scene load_steps=10 format=3]

[sub_resource type="GDScript" id="GDScript_forge"]
script/source = "extends StaticBody3D

@onready var buff_area: Area3D = $BuffArea

func _ready() -> void:
	if buff_area:
		buff_area.body_entered.connect(_on_troop_entered)

func _on_troop_entered(body: Node3D) -> void:
	if body.is_in_group(\"troops\") and body.get(\"base_damage\"):
		body.base_damage = int(body.base_damage * 1.3)
"

