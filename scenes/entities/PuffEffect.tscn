[gd_scene load_steps=5 format=3]

[sub_resource type="GDScript" id="GDScript_puff"]
script/source = "extends Node3D

var timer: float = 0.5

func _process(delta: float) -> void:
	timer -= delta
	scale += Vector3(delta * 2.0, delta * 2.0, delta * 2.0)
	position.y += delta * 1.5
	if timer <= 0.0:
		queue_free()
"

[sub_resource type="SphereMesh" id="SphereMesh_cloud"]
radius = 0.4
height = 0.8

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_puff"]
albedo_color = Color(0.78, 0.82, 0.88, 0.85)
transparency = 1
roughness = 0.9

[node name="PuffEffect" type="Node3D"]
script = SubResource("GDScript_puff")

[node name="MeshInstance3D" type="MeshInstance3D" parent="."]
mesh = SubResource("SphereMesh_cloud")
surface_material_override/0 = SubResource("StandardMaterial3D_puff")

