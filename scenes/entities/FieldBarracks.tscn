[gd_scene load_steps=15 format=3]

[sub_resource type="GDScript" id="GDScript_barracks"]
script/source = "extends StaticBody3D

@export var train_interval: float = 16.0
var timer: float = 0.0

@onready var label: Label3D = $Label3D

func _process(delta: float) -> void:
	if GameState.is_game_over or not GameState.is_stage_active:
		return
	timer += delta
	if label:
		label.text = \"🏹 Treinando Arqueiro: %d s\" % int(maxf(0.0, train_interval - timer))
	if timer >= train_interval:
		timer = 0.0
		_spawn_archer()

func _spawn_archer() -> void:
	var archer_scene = load(\"res://scenes/entities/Archer.tscn\")
	if archer_scene:
		var a = archer_scene.instantiate()
		get_parent().add_child(a)
		a.global_position = global_position + Vector3(randf_range(-1.2, 1.2), 0, 2.2)
		AudioManager.play_sfx(\"recruit\")
		Art.pop_in(a)
"

